# ───────── متغيرات البيئة — انسخ إلى .env محليًا وإلى Vercel → Settings → Environment Variables ─────────

# قاعدة بيانات Turso (إلزاميان)
# أنشئ قاعدة مجانية: turso db create <name> ثم:
#   turso db show <name> --url          → TURSO_DATABASE_URL
#   turso db tokens create <name>       → TURSO_AUTH_TOKEN
TURSO_DATABASE_URL=libsql://<db-name>-<org>.turso.io
TURSO_AUTH_TOKEN=<turso-token-with-write-access>

# ───────── اختياري — الحدود (القيم الافتراضية أدناه) ─────────
MAX_SOURCES=10
SOURCE_MAX_MB=200
OUTPUT_MAX_MB=150
MAX_TOTAL_DURATION_SEC=600
FFMPEG_PRESET=medium
